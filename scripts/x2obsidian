#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
if [ "$#" -eq 0 ]; then
  exec node "$SCRIPT_DIR/sync-x-to-obsidian.js" --current --open
fi
exec node "$SCRIPT_DIR/sync-x-to-obsidian.js" "$@"
